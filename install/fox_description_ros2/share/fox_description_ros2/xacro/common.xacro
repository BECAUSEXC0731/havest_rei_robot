<robot name="fox_common_part" xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="install_wheel" params="parent wheel xyz rpy sim">
    <link name="${wheel}_wheel_link">
      <xacro:if value="${sim}">
        <inertial>
          <origin xyz="0 -0.023418 0" rpy="0 0 0" />
          <mass value="0.09" />
          <inertia
            ixx="3.66237883360849E-05"
            ixy="-1.07450501014833E-11"
            ixz="4.36849497718242E-11"
            iyy="7.16917918078785E-05"
            iyz="-4.83231228289798E-12"
            izz="3.6623170495845E-05" />
        </inertial>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh
              filename="package://fox_description_ros2/meshes/wheel_link.STL" />
          </geometry>
        </collision>
      </xacro:if>
      <visual>
        <origin
          xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://fox_description_ros2/meshes/wheel_link.STL" />
        </geometry>
        <material name="">
          <color rgba="0.3 0.3 0.3 1" />
        </material>
      </visual>
    </link>
    <joint name="${wheel}_wheel_joint" type="fixed">
      <parent link="${parent}" />
      <child link="${wheel}_wheel_link" />
      <origin xyz="${xyz}" rpy="${rpy}" />
    </joint>
    <xacro:if value="${sim}">
      <gazebo reference="${wheel}_wheel_link">
        <material>Gazebo/FlatBlack</material>
      </gazebo>
    </xacro:if>
  </xacro:macro>
  <xacro:macro name="install_pnc" params="xyz rpy sim">
    <link name="pnc_link">
      <xacro:if value="${sim}">
        <inertial>
          <origin xyz="-0.0281 0.0 0.088" rpy="0 0 0" />
          <mass value="0.8" />
          <inertia
            ixx="0.0023318397606919"
            ixy="5.52683118480665E-06"
            ixz="-0.000392303737425478"
            iyy="0.00182406160898215"
            iyz="2.44517493403437E-06"
            izz="0.00206189637470412" />
        </inertial>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh
              filename="package://fox_description_ros2/meshes/pnc_link.STL" />
          </geometry>
        </collision>
      </xacro:if>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://fox_description_ros2/meshes/pnc_link.STL" />
        </geometry>
        <material name="">
          <color rgba="0.3 0.3 0.3 1" />
        </material>
      </visual>
    </link>
    <joint name="pnc_joint" type="fixed">
      <origin xyz="${xyz}" rpy="${rpy}" />
      <parent link="base_link" />
      <child link="pnc_link" />
    </joint>
    <link name="upper_support_link">
      <xacro:if value="${sim}">
        <inertial>
          <origin xyz="0 0.018830 0.0031260" rpy="0 0 0" />
          <mass value="0.039" />
          <inertia
            ixx="9.68456160213043E-05"
            ixy="2.30762230931714E-08"
            ixz="8.54907943216152E-13"
            iyy="4.26340461826438E-06"
            iyz="-6.34019963015385E-08"
            izz="9.91299748460666E-05" />
        </inertial>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="package://fox_description_ros2/meshes/upper_support_link.STL" />
          </geometry>
        </collision>
      </xacro:if>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://fox_description_ros2/meshes/upper_support_link.STL" />
        </geometry>
        <material name="">
          <color rgba="0.3 0.3 0.3 1" />
        </material>
      </visual>
    </link>
    <joint name="upper_support_joint" type="fixed">
      <origin xyz="0.047 0 0.22" rpy="0 0 0" />
      <parent link="pnc_link" />
      <child link="upper_support_link" />
    </joint>
    <xacro:if value="${sim}">
      <gazebo reference="pnc_link">
        <material>Gazebo/FlatBlack</material>
      </gazebo>
      <gazebo reference="upper_support_link">
        <material>Gazebo/FlatBlack</material>
      </gazebo>
    </xacro:if>
  </xacro:macro>
  <xacro:macro name="install_bottom_camera" params="xyz rpy sim">
    <link name="bottom_camera_link">
      <xacro:if value="${sim}">
        <inertial>
          <origin xyz="-0.0154297434875522 -2.94606187269403E-05 0.00240501152754317"
            rpy="0 0 0" />
          <mass
            value="0.0638785395895604" />
          <inertia
            ixx="5.19251303365607E-05"
            ixy="-1.31701296443244E-08"
            ixz="-4.63047834972811E-07"
            iyy="1.5078113084312E-05"
            iyz="-2.34924403876093E-08"
            izz="4.31313604268368E-05" />
        </inertial>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="package://fox_description_ros2/meshes/bottom_camera_link.STL" />
          </geometry>
        </collision>
      </xacro:if>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://fox_description_ros2/meshes/bottom_camera_link.STL" />
        </geometry>
        <material name="">
          <color rgba="0.3 0.3 0.3 1" />
        </material>
      </visual>
    </link>
    <joint name="bottom_camera_joint" type="fixed">
      <origin xyz="${xyz}" rpy="${rpy}" />
      <parent link="base_link" />
      <child link="bottom_camera_link" />
    </joint>
    <link name="bottom_camera_optical_link" />
    <joint name="bottom_camera_optical_joint" type="fixed">
      <parent link="bottom_camera_link" />
      <child link="bottom_camera_optical_link" />
      <origin xyz="0 0 0" rpy="-1.57079 0 -1.57079" />
    </joint>
    <xacro:if value="${sim}">
      <gazebo reference="bottom_camera_link">
        <material>Gazebo/FlatBlack</material>
      </gazebo>
    </xacro:if>
  </xacro:macro>
  <xacro:macro name="install_lidar" params="xyz rpy sim">
    <link name="front_lidar_link">
      <xacro:if value="${sim}">
        <inertial>
          <origin xyz="0.0025 0.018049 -0.0152661" rpy="0 0 0" />
          <mass value="0.229" />
          <inertia
            ixx="0.000253600718418092"
            ixy="2.47930682152809E-07"
            ixz="7.72156712422727E-06"
            iyy="0.000297886038597402"
            iyz="4.24022675840951E-06"
            izz="0.000454702953523578" />
        </inertial>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="package://fox_description_ros2/meshes/front_lidar_link.STL" />
          </geometry>
        </collision>
      </xacro:if>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://fox_description_ros2/meshes/front_lidar_link.STL" />
        </geometry>
        <material name="">
          <color rgba="0.3 0.3 0.3 1" />
        </material>
      </visual>
    </link>
    <joint name="front_lidar_joint" type="fixed">
      <origin xyz="${xyz}" rpy="${rpy}" />
      <parent link="base_link" />
      <child link="front_lidar_link" />
    </joint>
    <xacro:if value="${sim}">
      <gazebo reference="front_lidar_link">
        <material>Gazebo/FlatBlack</material>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>