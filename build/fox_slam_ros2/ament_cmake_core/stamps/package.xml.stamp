<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fox_slam_ros2</name>
  <version>0.1.0</version>
  <description>fox slam (ROS2) by Shenzhen Reinovo Technology Co., Ltd</description>
  <maintainer email="msnakes@qq.com">zq</maintainer>
  <license>AGPL</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>fox_description_ros2</exec_depend>
  <exec_depend>rei_robot_base</exec_depend>
  <exec_depend>ydlidar_ros2_driver</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>cartographer_ros</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
