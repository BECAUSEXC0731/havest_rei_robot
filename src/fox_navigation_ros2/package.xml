<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fox_navigation_ros2</name>
  <version>0.1.0</version>
  <description>fox navigation (ROS2) by Shenzhen Reinovo Technology Co., Ltd</description>
  <maintainer email="msnakes@qq.com">zq</maintainer>
  <license>AGPL</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>

  <exec_depend>fox_description_ros2</exec_depend>
  <exec_depend>rei_robot_base</exec_depend>
  <exec_depend>ydlidar_ros2_driver</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <!-- nav2_amcl 已被 lidar_loc 定位节点替代(保留依赖以便回退) -->
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
